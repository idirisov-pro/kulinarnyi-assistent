# Полный адрес YDB, включая параметр ?database=...
YDB_CONNECTION_STRING=grpcs://ydb.serverless.yandexcloud.net:2135/?database=/REGION/CLOUD_OR_FOLDER/DATABASE

# В Yandex Cloud Function использовать сервисный аккаунт функции через сервис метаданных.
YDB_METADATA_CREDENTIALS=1

# Допустимые браузерные источники через запятую.
KA_P0_ALLOWED_ORIGINS=https://idirisov-pro.github.io

# Необязательно. Имя таблицы событий.
KA_P0_EVENTS_TABLE=p0_events
